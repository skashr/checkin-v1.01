{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "每日打卡",
  "version": "0.1.0",
  "identifier": "com.dailycheckin.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "每日打卡",
        "width": 980,
        "height": 720,
        "minWidth": 640,
        "minHeight": 520,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
